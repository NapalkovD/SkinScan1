# Скопируйте эти строки в файл local.properties (его создаёт Android Studio, там уже есть sdk.dir)
# Qwen-VL через Alibaba Cloud Model Studio (DashScope), международный endpoint:
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-vl-plus
AI_API_KEY=sk-ВАШ_КЛЮЧ

# Альтернатива (OpenRouter, есть бесплатные модели с пометкой :free):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# AI_API_KEY=sk-or-ВАШ_КЛЮЧ
